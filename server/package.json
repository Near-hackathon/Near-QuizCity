{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch --import tsx src/index.ts",
    "start": "node --env-file=.env --import tsx src/index.ts",
    "db:push": "node --env-file=.env --import tsx scripts/db-push.ts",
    "db:reset": "node --env-file=.env --import tsx scripts/db-reset.ts",
    "typecheck": "tsc --noEmit",
    "db:seed": "node --env-file=.env --import tsx scripts/seed-demo.ts",
    "chain:seed": "node --env-file=.env --import tsx scripts/chain-seed.ts",
    "e2e": "node --env-file=.env --import tsx scripts/e2e.ts",
    "exploit": "node --env-file=.env --import tsx scripts/exploit.ts",
    "test": "node --import tsx --test test/config.test.ts test/demo.test.ts test/rotation.test.ts test/pagination.test.ts test/event-ledger.test.ts test/access-key.test.ts",
    "demo-keys:rotate": "node --env-file=.env --import tsx scripts/rotate-demo-keys.ts --confirm-demo-key-rotation",
    "demo-keys:rotate:dry-run": "node --env-file=.env --import tsx scripts/rotate-demo-keys.ts",
    "payout-key:verify": "node --env-file=.env --import tsx scripts/verify-operator-key.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "fastify": "^4.28.1",
    "near-api-js": "^4.0.4",
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
