# Environment: local | test | staging | production
APP_ENV=local
# Demo sign-in is opt-in and local/test only. 0 = disabled (default), 1 = enabled.
DEMO_MODE=0

# Local Postgres 17 (already running on 5432). Create the role/db once:
#   psql -U postgres -h localhost -c "CREATE ROLE quizcity LOGIN PASSWORD 'quizcity';"
#   psql -U postgres -h localhost -c "CREATE DATABASE quizcity OWNER quizcity;"
DATABASE_URL=postgresql://quizcity:quizcity@localhost:5432/quizcity
# Neon writes a pooled DATABASE_URL for the app and a direct DATABASE_URL_UNPOOLED.
# Migrations prefer the direct URL (PgBouncer transaction mode rejects some
# session-level operations); omit it locally to fall back to DATABASE_URL.
# DATABASE_URL_UNPOOLED=postgresql://...
# Disposable database used by `npm run db:test`. The integration tests create a
# unique temporary schema and drop only that schema. Never point this at staging
# or production.
TEST_DATABASE_URL=postgresql://quizcity:quizcity@localhost:5432/quizcity_test
# Set to "require" when pointing at Neon.
PGSSL=disable
# Use `require` for Neon or any remote TLS-only Postgres.

PORT=8787
HOST=127.0.0.1
WEB_ORIGIN=http://localhost:5173

NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
NEAR_CONTRACT_ID=quizcity.testnet
# Operator account holding the server's payout key. The server key must be a
# function-call key restricted to exactly
# credit_reward,pay_job,settle_escrow,npc_purchase on NEAR_CONTRACT_ID with a
# finite allowance. The default payout-key:verify command checks this v2 policy.
# Never put the deployer/recovery key here.
NEAR_OPERATOR_ACCOUNT=quizcity.testnet
NEAR_OPERATOR_PRIVATE_KEY=
# Deployment credential for `npm run chain:seed` only. Supply it in the shell
# (not in this file): NEAR_DEPLOY_PRIVATE_KEY=... npm run chain:seed
# It must be the contract account's offline full-access deploy/recovery key.
# NEAR_DEPLOY_PRIVATE_KEY=

# Optional: path to a local demo key file. Never commit this file or serve it in production.
# DEMO_ACCOUNTS_FILE=./demo-accounts.json

# NPC simulation cadence (ms)
NPC_TICK_MS=30000
CITY_TIMEZONE=Africa/Accra
NPC_SIMULATION_TICK_MS=1000
NPC_SIMULATION_CATCHUP_MS=300000

# Expose /documentation outside local development. Keep 0 unless explicitly needed.
ENABLE_API_DOCS=0
# API hardening
BODY_LIMIT=65536
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
# Set to 1 only behind a proxy you control.
TRUST_PROXY=0
SHUTDOWN_TIMEOUT_MS=10000
# Raise to 5000-10000 when DATABASE_URL points at Neon (scale-to-zero cold start).
READINESS_TIMEOUT_MS=2000

# Chain event indexer. The request/response contract is implemented in
# server/src/chain-source.ts.
# CHAIN_EVENT_SOURCE_URL=https://indexer.example/v1/quizcity/events
# CHAIN_SOURCE_REQUIRED=0
# Explicit first block to ingest (canonical decimal string). Never defaults to block zero.
# CHAIN_START_BLOCK=0
CHAIN_POLL_INTERVAL_MS=15000
CHAIN_PAGE_SIZE=100
CHAIN_FETCH_TIMEOUT_MS=5000
CHAIN_MAX_RETRIES=3

# Phase 6 world websocket/runtime limits. Keep these independent from HTTP limits.
WORLD_WS_MAX_PAYLOAD_BYTES=16384
WORLD_HEARTBEAT_MS=30000
WORLD_HEARTBEAT_TIMEOUT_MS=75000
WORLD_MAX_SOCKETS_PER_ACCOUNT=3
WORLD_MAX_SOCKETS_PER_IP=20
WORLD_MAX_QUEUED_BYTES=1048576
WORLD_REPLAY_LIMIT=200
WORLD_PRESENCE_TIMEOUT_MS=60000
WORLD_FANOUT_POLL_MS=100
WORLD_TICK_MS=250
WORLD_TILES_PER_TICK=1
WORLD_MOVE_COOLDOWN_MS=250
WORLD_MOVE_BURST=4
WORLD_INTERACTION_COOLDOWN_MS=500
WORLD_INTERACTION_BURST=2

# Separate game-managed accounts for username signup (non-production testnet only).
# Run npm run wallets:setup -- --enable at the repository root to generate/reuse
# a 32-byte encryption key and protected recovery copy; never paste that key here.
AUTO_TESTNET_WALLETS=0
TESTNET_WALLET_ENCRYPTION_KEY=
TESTNET_WALLET_FAUCET_URL=https://helper.nearprotocol.com/account
# UTC daily allocation AND sponsor-request budget. Public sponsor limits also apply.
TESTNET_WALLET_DAILY_LIMIT=8
# Leave testnet; custom suffixes are accepted only by a loopback test sandbox.
TESTNET_WALLET_ACCOUNT_SUFFIX=testnet
